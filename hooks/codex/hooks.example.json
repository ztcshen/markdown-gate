{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "'/path/to/node' '/path/to/markdown-gate/dist/cli.js' hook pre-tool-use # markdown-gate",
            "timeout": 30,
            "statusMessage": "Checking Markdown publish gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "'/path/to/node' '/path/to/markdown-gate/dist/cli.js' hook post-tool-use # markdown-gate",
            "timeout": 60,
            "statusMessage": "Checking Markdown final-state hygiene"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/path/to/node' '/path/to/markdown-gate/dist/cli.js' hook stop # markdown-gate",
            "timeout": 15,
            "statusMessage": "Checking Markdown delivery"
          }
        ]
      }
    ]
  }
}
